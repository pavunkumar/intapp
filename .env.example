# Copy to .env.local and fill in

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the webhook to update enrollments. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard -> Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Indian Nifty Trader <receipts@yourdomain.com>"

# Sanity (used once you move course content into the CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

NEXT_PUBLIC_SITE_URL=http://localhost:3000
